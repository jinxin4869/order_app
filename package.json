{
  "name": "qr-order-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "lint": "eslint src --ext .js,.jsx --ignore-pattern '**/__tests__/**'",
    "lint:fix": "eslint src --ext .js,.jsx --ignore-pattern '**/__tests__/**' --fix",
    "prepare": "husky",
    "test:all": "jest --runInBand && npm run test --prefix functions -- --runInBand",
    "check": "npm run lint && npm run lint --prefix functions && npm run test:all",
    "test:rules": "node test/run-rules.cjs",
    "build:web:test": "node test/build-web.cjs",
    "test:web": "npm run build:web:test && node test/web.smoke.cjs",
    "test:demo": "node test/run-rules.cjs --demo",
    "audit:dependencies": "node scripts/audit-dependencies.cjs",
    "test:audit": "node --test test/dependency-audit.test.cjs",
    "test:sdk": "node test/deepl.sdk.test.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.24",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.27",
    "expo-status-bar": "~56.0.4",
    "firebase": "^13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "firebase-tools": "^15.33.0",
    "husky": "^9.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "test-renderer": "~1.1.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/**/index.{js,jsx}"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/functions/"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "undici@6": "^6.28.1",
    "postcss": "^8.5.23"
  }
}
