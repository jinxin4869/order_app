# Cloud Functions の設定。functions/.env にコピーして使う（.env はコミットしない）。
# 値が "true" のときだけ強制する。未設定・その他の値では強制しない。

# App Check のトークンがない呼び出しを拒否する（docs/app_check.md）
ENFORCE_APP_CHECK=false

# 新規注文の連投制限を拒否として適用する。false の間は超過を記録するだけ（docs/order_limits.md）
ENFORCE_ORDER_LIMITS=false
# テーブルごとの 10 分あたりの新規注文数の上限（既定 10）
ORDER_LIMIT_PER_TABLE=10
# 店舗全体の 1 分あたりの新規注文数の上限（既定 60）
ORDER_LIMIT_PER_STORE=60

# テーブルの QR トークンを照合する。全テーブルの QR を貼り替えてから有効にする（docs/table_tokens.md）
ENFORCE_TABLE_TOKEN=false
