rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // レストラン情報（読み取りのみ）
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;

      // テーブル情報
      match /tables/{tableId} {
        allow read: if true;
        allow write: if false;
      }

      // メニューカテゴリ
      match /menu_categories/{categoryId} {
        allow read: if true;
        allow write: if false;
      }

      // メニュー項目：お客様に公開している商品（販売中・売り切れ）だけ読める。
      // is_published がない旧データは販売中のものだけを公開として扱う。
      match /menu_items/{itemId} {
        allow read: if resource.data.get('is_published', null) == true
          || (resource.data.get('is_published', null) == null
            && resource.data.get('is_available', false) == true);
        allow write: if false;
      }

      // 売り切れ・受付停止の操作記録はサーバーだけが読み書きする。
      match /menu_events/{eventId} {
        allow read, write: if false;
      }

      // 連投制限のカウンターと記録もサーバーだけが読み書きする。
      match /rate_limits/{counterId} {
        allow read, write: if false;
      }

      // テーブルのQRトークンのハッシュ。サーバーだけが読む。
      match /table_secrets/{tableId} {
        allow read, write: if false;
      }
    }

    // 注文は検証済みCallableのみが作成・更新する（Admin SDK）。
    match /orders/{orderId} {
      allow create: if false;
      allow read: if false;  // 将来的に認証実装時に変更
      allow update, delete: if false;

      // 状態変更の履歴もサーバー（Admin SDK）だけが読み書きする。
      match /status_history/{eventId} {
        allow read, write: if false;
      }

      // 商品の減数・取消の記録も同じ。
      match /corrections/{correctionId} {
        allow read, write: if false;
      }
    }

    // 辞書・キャッシュ（サーバーサイドのみ）
    match /dictionary/{entry} {
      allow read, write: if false;
    }

    match /translation_cache/{entry} {
      allow read, write: if false;
    }
  }
}
