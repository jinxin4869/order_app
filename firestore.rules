rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // クライアントは Firestore を直接読み書きしない。店舗・テーブル・メニューは
    // Callable（Admin SDK）だけが読み、公開する項目を選んで返す。
    match /restaurants/{restaurantId} {
      allow read, write: if false;

      // テーブル情報
      match /tables/{tableId} {
        allow read, write: if false;
      }

      // メニューカテゴリ
      match /menu_categories/{categoryId} {
        allow read, write: if false;
      }

      // メニュー項目
      match /menu_items/{itemId} {
        allow read, write: if false;
      }

      // 売り切れ・受付停止の操作記録はサーバーだけが読み書きする。
      match /menu_events/{eventId} {
        allow read, write: if false;
      }

      // 連投制限のカウンターと記録もサーバーだけが読み書きする。
      match /rate_limits/{counterId} {
        allow read, write: if false;
      }

      // 商品情報の下書き。公開するまでお客様にもクライアントにも見せない。
      match /menu_drafts/{itemId} {
        allow read, write: if false;
      }

      // テーブルのQRトークンのハッシュ。サーバーだけが読む。
      match /table_secrets/{tableId} {
        allow read, write: if false;
      }
    }

    // 注文は検証済みCallableのみが作成・更新する（Admin SDK）。
    match /orders/{orderId} {
      allow create: if false;
      allow read: if false;  // 将来的に認証実装時に変更
      allow update, delete: if false;

      // 状態変更の履歴もサーバー（Admin SDK）だけが読み書きする。
      match /status_history/{eventId} {
        allow read, write: if false;
      }

      // 商品の減数・取消の記録も同じ。
      match /corrections/{correctionId} {
        allow read, write: if false;
      }
    }

    // 辞書・キャッシュ（サーバーサイドのみ）
    match /dictionary/{entry} {
      allow read, write: if false;
    }

    match /translation_cache/{entry} {
      allow read, write: if false;
    }
  }
}
