# Firebase Web application configuration. Fill in your own project values.
# Never put the DeepL Secret or service-account private keys in the frontend.
FIREBASE_API_KEY=replace_with_web_api_key
FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_STORAGE_BUCKET=replace_with_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
FIREBASE_APP_ID=replace_with_web_app_id
SENTRY_DSN=
# App Check (web only). reCAPTCHA Enterprise site key; this value is public.
# Leave empty locally. Set it before enabling ENFORCE_APP_CHECK in Functions.
FIREBASE_APPCHECK_SITE_KEY=
